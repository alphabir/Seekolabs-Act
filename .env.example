# PORT: The port the Express host listens on.
# Cloud Run and most PaaS hosts inject this automatically. Defaults to 3000.
PORT="3000"

# NODE_ENV: Set to "production" to serve the built dist/ folder instead of
# starting Vite in middleware mode. `npm start` passes --production instead,
# so this is only needed when running dist/server.cjs directly.
NODE_ENV="production"
