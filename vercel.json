{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/pujo-passport/", "destination": "/pujo-passport", "permanent": true },
    { "source": "/pujo-passport/:path+/", "destination": "/pujo-passport/:path+", "permanent": true }
  ],
  "rewrites": [
    { "source": "/pujo-passport", "destination": "https://pujo-passport.vercel.app/pujo-passport" },
    { "source": "/pujo-passport/:path*", "destination": "https://pujo-passport.vercel.app/pujo-passport/:path*" }
  ],
  "headers": [
    {
      "source": "/((?!pujo-passport).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/pujo-passport/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/ludo-apex/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
